<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/dialog_padding">

    <ImageView
        android:id="@+id/qrImage"
        android:layout_width="@dimen/qr_size"
        android:layout_height="@dimen/qr_size"
        android:background="@android:color/white"
        android:contentDescription="@string/remote_title"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_xsmall"
            android:text="@string/remote_title"
            android:textAppearance="@style/TextAppearance.TVSig.Title" />

        <TextView
            android:id="@+id/remoteUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.TVSig.Body"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/remoteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xsmall"
            android:text="@string/remote_hint"
            android:textAppearance="@style/TextAppearance.TVSig.Caption" />

        <Button
            android:id="@+id/btnClose"
            style="@style/Widget.TVSig.Button.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="@string/button_close" />
    </LinearLayout>
</LinearLayout>
