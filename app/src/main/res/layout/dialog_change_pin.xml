<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/dialog_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pinStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_xsmall"
            android:text="@string/pin_current"
            android:textAppearance="@style/TextAppearance.TVSig.Title" />

        <TextView
            android:id="@+id/pinStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:minHeight="28dp"
            android:textAppearance="@style/TextAppearance.TVSig.Caption"
            android:textColor="?attr/colorError" />

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.TVSig.Button.Tertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_cancel" />
    </LinearLayout>

    <com.kutlusoy.tvsig.ui.views.PinPadView
        android:id="@+id/pinPad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium" />
</LinearLayout>
