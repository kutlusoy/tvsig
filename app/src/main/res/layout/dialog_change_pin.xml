<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pin_current"
        android:textAppearance="@style/TextAppearance.TvSig.Title"
        android:layout_marginBottom="@dimen/margin_medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_large">

        <EditText
            android:id="@+id/currentPinDigit1"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/currentPinDigit2"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/currentPinDigit3"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/currentPinDigit4"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pin_new"
        android:textAppearance="@style/TextAppearance.TvSig.Title"
        android:layout_marginBottom="@dimen/margin_medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_large">

        <EditText
            android:id="@+id/newPinDigit1"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/newPinDigit2"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/newPinDigit3"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/newPinDigit4"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pin_confirm_new"
        android:textAppearance="@style/TextAppearance.TvSig.Title"
        android:layout_marginBottom="@dimen/margin_medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margin_large">

        <EditText
            android:id="@+id/confirmPinDigit1"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/confirmPinDigit2"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/confirmPinDigit3"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>

        <EditText
            android:id="@+id/confirmPinDigit4"
            style="@style/Widget.TvSig.PinEntry"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:background="@drawable/selector_pin_input"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.TvSig.Button.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_medium"
            android:text="@string/button_cancel" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.TvSig.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_save" />
    </LinearLayout>

</LinearLayout>