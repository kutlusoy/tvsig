<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/remote_title"
        android:textAppearance="@style/TextAppearance.TVSig.Title"
        android:layout_marginBottom="@dimen/margin_small" />

    <ImageView
        android:id="@+id/qrImage"
        android:layout_width="@dimen/qr_size"
        android:layout_height="@dimen/qr_size"
        android:layout_gravity="center_horizontal"
        android:background="@android:color/white"
        android:contentDescription="@string/remote_title"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/remoteUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TVSig.Body"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/remoteStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:gravity="center"
        android:text="@string/remote_hint"
        android:textAppearance="@style/TextAppearance.TVSig.Caption" />

    <Button
        android:id="@+id/btnClose"
        style="@style/Widget.TVSig.Button.Tertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/button_close" />
</LinearLayout>
